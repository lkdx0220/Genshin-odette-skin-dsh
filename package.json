{
    "name": "dsh-odette-skin",
    "version": "0.1.1",
    "description": "Odette 冰雪梦幻主题：深/浅双模式 UI 美化皮肤（背景图 + 主题 token + 毛玻璃）",
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/types/index.d.ts",
    "files": [
        "lib",
        "assets",
        "cordis.patch.yml"
    ],
    "license": "CC-BY-NC-SA-4.0",
    "peerDependencies": {
        "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2",
        "cordis": ">=4.0.0-rc <5"
    },
    "devDependencies": {
        "@rolldown/binding-win32-x64-msvc": "^1.2.4",
        "@types/node": "^24.13.3",
        "lightningcss": "^1.33.0",
        "tsdown": "^0.22.14",
        "typescript": "^5.9.0"
    },
    "scripts": {
        "build": "node scripts/build.cjs",
        "prepare": "npm run build",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "build:client": "tsdown"
    },
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/index.js"
        },
        "./client": {
            "default": "./lib/client.js"
        },
        "./package.json": "./package.json"
    },
    "dsh": {
        "client": {
            "inject": [
                "@deepseek-ai/dsh-client-ui-slots"
            ],
            "platform": "web"
        },
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    }
}
